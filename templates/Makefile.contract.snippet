# shepherd dev-cycle contract (SH-014)
# -----------------------------------------------------------------------------
# Include this snippet from your repo Makefile. Each repo supplies its real
# `build`, `test`, `lint` recipes; the snippet defines the eight contract
# targets with sensible default aliases, plus timing wrappers.
#
# Usage in your Makefile:
#
#   include .make/shepherd-contract.mk   # or wherever you drop this file
#
#   # Your repo-specific targets:
#   build:      ; zig build --prefix .
#   test:       ; test/acceptance/...
#   lint:       ; yamllint .
#
#   # Anchor on your repo's native idiom (optional — defaults below work):
#   test-affected:     test-updates       # homelab
#   # test-affected:   ; scripts/smart-check.sh         # forge
#   # test-affected:   ; pytest -n auto -m "not slow"   # beaconry
#
# The four CI tiers reference your repo-specific targets. Override any tier
# body by redefining it after the include.
#
# Spec: docs/specs/dev-cycle-contract.md + docs/specs/ci-timing.md
# -----------------------------------------------------------------------------

.PHONY: ci-branch ci-patch ci-release ci-release-promote ci-nightly ci-nightly-body \
        test-affected smoke release-artifacts \
        ci-timing-init

# Budgets (seconds). Match workflow timeout-minutes × 60.
CI_BRANCH_BUDGET  ?= 300
CI_PATCH_BUDGET   ?= 300
CI_RELEASE_BUDGET ?= 900
CI_NIGHTLY_BUDGET ?= 0      # 0 = unbounded (ci-nightly)

CI_TIMING_FILE  ?= build/ci-timing.json
CI_STEPS_FILE   ?= build/ci-steps.jsonl
CI_RELEASE_DIR  ?= build/release

# -----------------------------------------------------------------------------
# Default aliases — override in your Makefile if your repo has a native idiom.
# A repo with no affected-only mechanism stays compliant via the identity alias
# (test-affected: test); the speedup lands later as a dedicated SH.
# -----------------------------------------------------------------------------

test-affected: test

# Default smoke = test. Image repos override to `docker run --health-cmd` etc.
smoke: test

# Default release-artifacts = build. Image repos override to push sha-<commit>
# to a registry. Pure-test repos may leave the default (empty build/ dir is fine).
release-artifacts: build

# -----------------------------------------------------------------------------
# Timing helpers
# -----------------------------------------------------------------------------

# $(call step,NAME,RECIPE) — run RECIPE, append {name,seconds} to the steps file.
# IMPORTANT: inner recipe's exit code must propagate. Captured as _rc before
# the timing emission, replayed via `exit $$_rc` after. A plain `$(2);` with
# subsequent `;`-chained commands masks the failure (make sees the final exit
# code of the compound, which is always 0 for the timing write). This bug bit
# shepherd ci-release-promote on 2026-11-22 (push rejected by ruleset, job
# reported success).
define step
	@mkdir -p $(dir $(CI_STEPS_FILE))
	@_t0=$$(date +%s.%N); \
	 $(2); _rc=$$?; \
	 _t1=$$(date +%s.%N); \
	 _secs=$$(awk -v a="$$_t1" -v b="$$_t0" 'BEGIN{printf "%.3f", a-b}'); \
	 printf '{"name":"%s","seconds":%s}\n' "$(1)" "$$_secs" >> $(CI_STEPS_FILE); \
	 exit $$_rc
endef

ci-timing-init:
	@mkdir -p $(dir $(CI_STEPS_FILE)) $(CI_RELEASE_DIR)
	@: > $(CI_STEPS_FILE)
	@echo "$$(date -u +%FT%TZ)" > build/ci-started-at

# $(call ci-timing-finish-cmd,TARGET,BUDGET) — emit build/ci-timing.json.
define ci-timing-finish-cmd
	finished_at=$$(date -u +%FT%TZ); \
	started_at=$$(cat build/ci-started-at 2>/dev/null || echo "$$finished_at"); \
	total=$$(awk -F'"seconds":' '/"seconds":/ { s=$$2; gsub(/[^0-9.]/, "", s); sum+=s } END{ printf "%.3f", sum }' $(CI_STEPS_FILE) 2>/dev/null || echo 0); \
	git_sha=$$(git rev-parse --short HEAD 2>/dev/null || echo unknown); \
	runner=$${RUNNER_OS:+$${RUNNER_OS}-$${RUNNER_ARCH}}; \
	runner=$${runner:-$$(uname -s)-$$(uname -m)}; \
	steps_json=$$(awk 'BEGIN{printf "["} NR>1{printf ","} {printf "%s", $$0} END{printf "]"}' $(CI_STEPS_FILE) 2>/dev/null || echo '[]'); \
	printf '{"schema_version":1,"target":"%s","budget_seconds":%s,"total_seconds":%s,"steps":%s,"git_sha":"%s","runner":"%s","started_at":"%s","finished_at":"%s"}\n' \
	  "$(1)" "$(2)" "$$total" "$$steps_json" "$$git_sha" "$$runner" "$$started_at" "$$finished_at" \
	  > $(CI_TIMING_FILE)
endef

# -----------------------------------------------------------------------------
# Tier bodies — override in your Makefile if a tier needs a different recipe.
# -----------------------------------------------------------------------------

# ci-branch: lint + affected-only test + build the artifact ONCE.
# The workflow (templates/ci-branch.yml) then uploads build/release/** keyed
# by commit SHA for cross-tier promotion.
ci-branch: ci-timing-init
	$(call step,lint,$(MAKE) lint)
	$(call step,test-affected,$(MAKE) test-affected)
	$(call step,release-artifacts,$(MAKE) release-artifacts)
	@$(call ci-timing-finish-cmd,ci-branch,$(CI_BRANCH_BUDGET))

# ci-patch: downloads the ci-branch artifact (via the workflow) and smokes it.
# No build. No release-artifacts. Repos with a staging env override `smoke` to
# deploy to staging + health-check.
ci-patch: ci-timing-init
	$(call step,smoke,$(MAKE) smoke)
	@$(call ci-timing-finish-cmd,ci-patch,$(CI_PATCH_BUDGET))

# ci-release-promote: fast-forward main to dev + tag from VERSION.
# Shared across the fleet (SH-029). Repos' `make ci-release` should call this
# then add their own publish/sign/SBOM steps. Must run on `dev` branch.
# Mutates the working tree; intended for CI only.
ci-release-promote:
	@current=$$(git branch --show-current); \
	 [ "$$current" = "dev" ] || { echo "ci-release-promote must run on 'dev', got '$$current'"; exit 1; }
	@[ -f VERSION ] || { echo "VERSION file missing — cannot determine tag"; exit 1; }
	@version=$$(cat VERSION | tr -d '[:space:]'); \
	 echo "SH-029 promote: dev → main as v$$version"; \
	 git fetch origin main && \
	 git checkout main && \
	 git merge --ff-only origin/dev && \
	 git tag "v$$version" HEAD && \
	 git push origin main && \
	 git push origin "v$$version" && \
	 git checkout dev

# ci-release: default body calls promote-only (no repo-specific publish).
# Repos override to add SBOM / signing / image push / release notes AFTER
# ci-release-promote (do the promote first so anything we sign is what landed).
ci-release: ci-timing-init
	$(call step,release-promote,$(MAKE) ci-release-promote)
	@$(call ci-timing-finish-cmd,ci-release,$(CI_RELEASE_BUDGET))

# ci-nightly: slow lane. Failures open a needs-human issue (research-doc
# checklist). Repos override `ci-nightly-body` with their nightly recipe; the
# issue wrapper stays.
ci-nightly: ci-timing-init
	@if ! $(MAKE) ci-nightly-body; then \
	  rc=$$?; \
	  if command -v gh >/dev/null 2>&1 && [ -n "$$GITHUB_REPOSITORY" ]; then \
	    gh issue create \
	      --title "[shepherd] ci-nightly failed on $$(git rev-parse --short HEAD 2>/dev/null || echo HEAD)" \
	      --body "ci-nightly failed with exit code $$rc. Workflow run: $${GITHUB_SERVER_URL:-https://github.com}/$${GITHUB_REPOSITORY}/actions/runs/$${GITHUB_RUN_ID}." \
	      --label needs-human || true; \
	  fi; \
	  exit $$rc; \
	fi
	@$(call ci-timing-finish-cmd,ci-nightly,$(CI_NIGHTLY_BUDGET))

# Default body: placeholder. Repos override with their full slow suite.
ci-nightly-body:
	@echo "override ci-nightly-body in your Makefile with the slow suite (full matrix, cold builds, kernel builds, etc.)"
